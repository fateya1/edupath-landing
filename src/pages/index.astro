<script is:inline>(function(){
  function init(){
    var root=document.getElementById('ep-tour'); if(!root) return;
    var $=function(i){return document.getElementById(i);};
    var K=['solve','fees','fin','kemis','hr','proc'], P={solve:$('ep-solve'),fees:$('ep-fees'),fin:$('ep-fin'),kemis:$('ep-kemis'),hr:$('ep-hr'),proc:$('ep-proc')}, tabs={};
    K.forEach(function(k){tabs[k]=$('ept-t-'+k);});
    var pb=$('ept-pause'), rb=$('ept-replay'), T=window.EPTours=window.EPTours||{};
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cur=null, paused=false, chain=false, held=false, started=false, timer=0;
    var CHAIN=['solve','fees','fin'];            // tours that autoplay one after another; tabs added later do not
