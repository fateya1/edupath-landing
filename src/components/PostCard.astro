---
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, description, tag, dateDisplay, readTime } = post.data;
const href = `/blog/${post.id}/`;
---

<article class="post-card">
  <a class="post-card-link" href={href}>
    <div class="post-card-rule" aria-hidden="true"></div>
    <span class="post-card-tag">{tag}</span>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-excerpt">{description}</p>
    <div class="post-card-foot">
      <span class="post-card-meta">{dateDisplay} · {readTime}</span>
      <span class="post-card-more">Read article →</span>
    </div>
  </a>
</article>

<style>
.post-card {
  min-width: 0;
  border: 1px solid var(--color-rule);
  border-radius: var(--radius-card);
  background: var(--color-paper-2);
  transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}
.post-card:hover { border-color: var(--color-rule-2); transform: translateY(-2px); }
.post-card-link { display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-lg); height: 100%; }
.post-card-rule { width: 2.5rem; height: 2px; background: var(--color-accent); }
.post-card-tag {
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted);
}
.post-card-title {
  font-family: var(--font-display);
  font-size: var(--text-md);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--color-ink);
}
.post-card-title:hover { color: var(--color-focus); }
.post-card-excerpt {
  font-size: var(--text-sm);
  color: var(--color-muted);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-card-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1px solid var(--color-rule);
}
.post-card-meta { font-size: var(--text-xs); color: var(--color-muted); white-space: nowrap; }
.post-card-more { font-size: var(--text-sm); font-weight: 600; color: var(--color-ink-2); white-space: nowrap; }
.post-card:hover .post-card-more { color: var(--color-focus); }
</style>