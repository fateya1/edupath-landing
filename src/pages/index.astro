<script is:inline>(function(){
  function init(){
  var root=document.getElementById('ep-solve'); if(!root) return;
  var D=['Monday','Tuesday','Wednesday','Thursday','Friday'];
  var P=[['08:00','08:40'],['08:45','09:25'],['09:30','10:10'],['10:30','11:10'],['11:15','11:55'],['12:00','12:40'],['13:20','14:00'],['14:05','14:45'],['14:50','15:30']];
  var BR={3:'10:10 - 10:30',6:'12:40 - 13:20'}; // break shown before this period index
  var S={
    MAT:['Mathematics','David Kamau','#EA580C','Math'], KIS:['Kiswahili','Fatuma Hassan','#0D9488','Kisw'], PHY:['Physics','Kiprop Ruto','#DC2626','Phys'],
    BIO:['Biology','Otieno Odhiambo','#A23FE0','Bio'], CS:['Computer Studies','Beatrice Ndungu','#16A34A','CS'], ENG:['English','Grace Wanjiku','#6D5BD0','Eng'],
    PE:['Physical Education','Samuel Mwenda','#D97706','PE'], CHE:['Chemistry','Otieno Odhiambo','#0891B2','Chem']
  };
  // final timetable: one array per day, one entry per period
  var G=[
    ['MAT','ENG','KIS','PE','PHY','CHE','BIO','CS','MAT'],
    ['KIS','PE','PHY','CHE','BIO','CS','MAT','ENG','KIS'],
    ['PHY','CHE','BIO','CS','MAT','ENG','KIS','PE','PHY'],
    ['BIO','CS','MAT','ENG','KIS','PE','PHY','CHE','BIO'],
    ['CS','MAT','ENG','KIS','PE','PHY','CHE','BIO','CS']
  ];
  var CL=[7,20,33]; // placement steps where a clash is shown
  var grid=document.getElementById('eps-grid'), log=document.getElementById('eps-log'),
      n1=document.getElementById('eps-n1'), n2=document.getElementById('eps-n2'), n3=document.getElementById('eps-n3'),
      sr=document.getElementById('eps-sr'), btn=document.getElementById('eps-go');
  var cells={}, order=[], token=0, started=false, total=0;
  function el(t,c,x){var e=document.createElement(t); if(c)e.className=c; if(x!=null)e.textContent=x; return e;}

  grid.appendChild(el('div','eps-h','Period'));
  D.forEach(function(d){grid.appendChild(el('div','eps-h',d));});
  for(var r=0;r<9;r++){
    if(BR[r]){ grid.appendChild(el('div','eps-brk','Break')); grid.appendChild(el('div','eps-brkt',BR[r])); }
    var per=el('div','eps-per'); var pb=el('b'); pb.appendChild(el('span','eps-f','Period '+(r+1))); pb.appendChild(el('span','eps-s','P'+(r+1))); per.appendChild(pb); per.appendChild(el('span','eps-t',P[r][0]+' - '+P[r][1])); grid.appendChild(per);
    for(var c=0;c<5;c++){var cell=el('div','eps-cell'); cell.setAttribute('aria-hidden','true'); cells[r+'-'+c]=cell; grid.appendChild(cell);}
  }
  for(var i=0;i<45;i++){var k=(i*7)%45, cc=Math.floor(k/9), rr=k%9; order.push([rr,cc]); total++;}

  function fill(key,code,bad){
    var s=S[code], e=cells[key]; e.innerHTML='';
    e.style.setProperty('--c',bad?'#B91C1C':s[2]);
    e.className='eps-cell '+(bad?'bad':'on');
    var nb=el('b'); nb.appendChild(el('span','eps-f',s[0])); nb.appendChild(el('span','eps-s',s[3])); e.appendChild(nb); e.appendChild(el('i','',s[1]));
  }
  function clear(key){var e=cells[key]; e.className='eps-cell'; e.innerHTML=''; e.style.removeProperty('--c');}
  function slot(o){return D[o[1]].slice(0,3)+' '+P[o[0]][0];}
  function say(t,bad){log.textContent=t; log.className='eps-log'+(bad?' bad':'');}
  function reset(){for(var k in cells)clear(k); n1.textContent='0'; n2.textContent='0'; n3.textContent='\u2013'; say('Placing lessons\u2026');}
  function done(caught){
    n3.textContent='0';
    var msg='All '+total+' lessons placed. '+caught+' clashes caught and fixed. 0 clashes in the final timetable.';
    say(msg); sr.textContent=msg; btn.disabled=false; btn.removeAttribute('aria-busy'); btn.textContent='Generate again';
  }

  function run(instant){
    token++; var my=token; reset(); btn.disabled=true; btn.setAttribute('aria-busy','true');
    if(instant){
      order.forEach(function(o){fill(o[0]+'-'+o[1],G[o[1]][o[0]]);});
      n1.textContent=total; n2.textContent=CL.length; done(CL.length); return;
    }
    var i=0, caught=0;
    (function step(){
      if(my!==token) return;
      if(i>=order.length){done(caught); return;}
      var o=order[i], key=o[0]+'-'+o[1], code=G[o[1]][o[0]], s=S[code];
      if(CL.indexOf(i)>-1){
        var w=null; for(var j=order.length-1;j>i;j--){ if(order[j][0]+'-'+order[j][1]!==key){w=order[j];break;} }
        var wk=w[0]+'-'+w[1],
            why=(code==='CHE'||code==='PHY'||code==='BIO')?'the lab is booked by another class':(code==='CS')?'the computer room is booked by another class':s[1]+' is already teaching another class';
        fill(wk,code,true); say('Clash on '+slot(w)+': '+why+'. Moving '+s[0]+'\u2026',true);
        setTimeout(function(){
          if(my!==token) return;
          clear(wk); fill(key,code); caught++; n1.textContent=i+1; n2.textContent=caught;
          say('Moved '+s[0]+' to '+slot(o)+'.'); i++; setTimeout(step,300);
        },1100);
      } else {
        fill(key,code); n1.textContent=i+1; say('Placed '+s[0]+' on '+slot(o)+'.'); i++; setTimeout(step,100);
      }
    })();
  }

  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  btn.addEventListener('click',function(){run(reduce);});
  function auto(){ if(started) return; started=true; run(reduce); }
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es,ob){ if(es[0].isIntersecting){auto(); ob.disconnect();} },{threshold:.25}).observe(root);
  } else { auto(); }
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
(function(){
  function init(){
  var root=document.getElementById('ep-fees'); if(!root) return;
  var $=function(i){return document.getElementById(i);};
  var app=$('epm-app'), cur=$('epm-cur'), body=$('epm-body'), feed=$('epm-feed'), cCol=$('epm-col'), cOut=$('epm-out'), sr=$('epm-sr'), btn=$('epm-go');
  var tabEls={}; [].forEach.call(root.querySelectorAll('.epm-tab'),function(t){tabEls[t.getAttribute('data-v')]=t;});
  var R=[['Dorothy Cynthia Mutiso','DEM237',59500,29000],['Moses Hassan Kioko','DEM238',50000,0],['Kamau David Kamau','DEM240',52000,52000],['Felicity Nafula Nzomo','DEM239',67000,67000],['Kenneth Nicholas Makau','DEM236',52000,39500]];
  var E=[{i:0,amt:30500},{i:1,amt:20000},{i:4,amt:12500}];
  var S, trs, token=0, started=false, instant=false;
  function fmt(n){return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
  function st(r){return r.p>=r.t?'PAID':(r.p>0?'PARTIAL':'UNPAID');}
  function anim(el,from,to,dur){
    if(instant||from===to){el.textContent='KES '+fmt(to);return;}
    var t0=null,my=token;
    requestAnimationFrame(function f(ts){
      if(my!==token) return; if(t0===null) t0=ts;
      var k=Math.min(1,(ts-t0)/dur), e=1-Math.pow(1-k,3);
      el.textContent='KES '+fmt(from+(to-from)*e);
      if(k<1) requestAnimationFrame(f);
    });
  }
  function build(){
    S={rows:R.map(function(r){return {n:r[0],a:r[1],t:r[2],p:r[3]};}),col:28480500,out:6743500};
    body.innerHTML=''; trs=[];
    S.rows.forEach(function(r){
      var tr=document.createElement('tr');
      tr.innerHTML='<td>'+r.n+'</td><td>'+r.a+'</td><td>THIRD</td><td>Tuition Fees</td><td>KES '+fmt(r.t)+'</td><td class="epm-pd">KES '+fmt(r.p)+'</td><td class="epm-bl">KES '+fmt(r.t-r.p)+'</td><td><span class="epm-chip '+st(r)+'">'+st(r)+'</span></td><td><span class="epm-act">Actions \u25BE</span></td>';
      body.appendChild(tr); trs.push(tr);
    });
    cCol.textContent='KES '+fmt(S.col); cOut.textContent='KES '+fmt(S.out);
  }
  function chip(i,pop){var c=trs[i].querySelector('.epm-chip'),s=st(S.rows[i]); c.className='epm-chip '+s+(pop?' pop':''); c.textContent=s;}
  function say(cls,t){feed.className='epm-feed'+(cls?' '+cls:''); feed.innerHTML=''; var s=document.createElement('span'); s.textContent=t; feed.appendChild(s);}
  function pay(i,amt){
    var r=S.rows[i], tr=trs[i], pd=tr.querySelector('.epm-pd'), bl=tr.querySelector('.epm-bl');
    var p0=r.p, c0=S.col, o0=S.out; r.p+=amt; S.col+=amt; S.out-=amt;
    if(!instant) tr.classList.add('flash');
    anim(pd,p0,r.p,700); anim(bl,r.t-p0,r.t-r.p,700); anim(cCol,c0,S.col,900); anim(cOut,o0,S.out,900);
    if(instant){chip(i,false);return;}
    setTimeout(function(){chip(i,true);},700);
    setTimeout(function(){tr.classList.remove('flash');},1400);
  }
  function setTab(v){
    for(var k in tabEls) tabEls[k].classList.toggle('on',k===v);
    [].forEach.call(root.querySelectorAll('.epm-v'),function(x){x.classList.remove('show');});
    $('epm-v-'+v).classList.add('show');
  }
  function resetViews(){
    ['epm-i-stu','epm-i-amt','epm-i-fs','epm-i-find'].forEach(function(i){var e=$(i); e.textContent=''; e.classList.remove('typing');});
    $('epm-chk').classList.remove('on'); $('epm-save').className='epm-ind'; $('epm-save').textContent='Save Fee Structure';
    $('epm-empty').hidden=false; $('epm-hit').hidden=true; $('epm-a1').classList.remove('sel');
    $('epm-send').className='epm-ind'; $('epm-send').textContent='Send SMS Reminders';
    $('epm-now').className='epm-b2 amber'; $('epm-now').textContent='Send Reminders Now';
    [].forEach.call(root.querySelectorAll('#epm-aud-body tr'),function(r){r.className='epm-hide';});
  }
  function wait(ms,my){return new Promise(function(res,rej){setTimeout(function(){my===token?res():rej('x');},ms);});}
  function moveTo(el,my,dx){
    var a=app.getBoundingClientRect(), r=el.getBoundingClientRect();
    var x=r.left-a.left+Math.min(r.width*0.55,r.width-8)+(dx||0), y=r.top-a.top+r.height*0.5;
    cur.style.transform='translate('+x+'px,'+y+'px)'; return wait(800,my);
  }
  function click(el,my){
    cur.classList.remove('click'); void cur.offsetWidth; cur.classList.add('click'); el.classList.add('press');
    setTimeout(function(){el.classList.remove('press'); cur.classList.remove('click');},400); return wait(260,my);
  }
  async function type(el,text,my){
    el.classList.add('typing');
    for(var i=1;i<=text.length;i++){el.textContent=text.slice(0,i); await wait(42,my);}
    el.classList.remove('typing');
  }
  async function visit(v,my,fn){
    await moveTo(tabEls[v],my); await click(tabEls[v],my); setTab(v); await wait(300,my);
    if(fn) await fn(); await wait(550,my);
  }
  async function tour(my){
    cur.style.transition='none'; cur.style.transform='translate('+Math.round(app.clientWidth*0.6)+'px,'+Math.round(app.clientHeight*0.45)+'px)';
    void cur.offsetWidth; cur.style.transition=''; cur.classList.add('vis');
    await wait(600,my);
    for(var k=0;k<E.length;k++){
      var e=E[k], r=S.rows[e.i];
      say('pay','M-Pesa payment received: KES '+fmt(e.amt)+' for '+r.a+', '+r.n); await wait(600,my);
      pay(e.i,e.amt); await wait(1200,my);
    }
    say('','Balances, statuses and totals are up to date.'); await wait(500,my);
    await visit('add',my,async function(){
      var s=$('epm-i-stu'), a=$('epm-i-amt');
      await moveTo(s,my); await click(s,my); await type(s,'DEM240  Kamau David Kamau',my);
      await moveTo(a,my); await click(a,my); await type(a,'52000',my);
      await moveTo($('epm-chk'),my,-60); await click($('epm-chk'),my); $('epm-chk').classList.add('on');
    });
    await visit('str',my,async function(){
      var f=$('epm-i-fs'), sv=$('epm-save');
      await moveTo(f,my); await click(f,my); await type(f,'52000',my);
      await moveTo(sv,my); await click(sv,my); sv.classList.add('sent'); sv.textContent='Fee structure saved';
    });
    await visit('edit',my,async function(){
      var f=$('epm-i-find'), r=S.rows[1];
      await moveTo(f,my); await click(f,my); await type(f,'DEM238',my); await wait(300,my);
      $('epm-empty').hidden=true; var h=$('epm-hit'); h.hidden=false;
      h.innerHTML='<b>'+r.n+'</b> &nbsp;'+r.a+' &middot; Tuition Fees &middot; THIRD<br><span style="font-size:.74rem">Total KES '+fmt(r.t)+' &nbsp; <span class="epm-pd">Paid KES '+fmt(r.p)+'</span> &nbsp; <span class="epm-bl">Balance KES '+fmt(r.t-r.p)+'</span></span> &nbsp; <span class="epm-chip '+st(r)+'">'+st(r)+'</span>';
    });
    await visit('sms',my,async function(){
      var a=$('epm-a1'), sd=$('epm-send');
      await moveTo(a,my); await click(a,my); a.classList.add('sel'); await wait(300,my);
      await moveTo(sd,my); await click(sd,my); sd.textContent='Sending\u2026'; await wait(600,my);
      sd.classList.add('sent'); sd.textContent='Sent to 399 parents';
    });
    await visit('auto',my,async function(){
      var n=$('epm-now');
      await moveTo(n,my); await click(n,my); n.classList.add('sent'); n.textContent='Reminders sent';
    });
    await visit('aud',my,async function(){
      var rows=root.querySelectorAll('#epm-aud-body tr');
      for(var i=0;i<rows.length;i++){rows[i].className='epm-in'; await wait(400,my);}
    });
    await moveTo(tabEls.rec,my); await click(tabEls.rec,my); setTab('rec'); await wait(900,my);
  }
  function finish(){
    var m='Tour finished. Payments applied, reminders sent and every change recorded in the audit trail.';
    cur.classList.remove('vis'); say('','Balances, statuses and totals are up to date.'); sr.textContent=m;
    btn.disabled=false; btn.removeAttribute('aria-busy'); btn.textContent='Replay tour';
  }
  function run(inst){
    token++; var my=token; instant=inst; build(); resetViews(); setTab('rec'); say('','Waiting for the next payment\u2026'); sr.textContent='';
    btn.disabled=true; btn.setAttribute('aria-busy','true');
    if(inst){E.forEach(function(e){pay(e.i,e.amt);}); finish(); return;}
    tour(my).then(finish,function(e){if(e!=='x') finish();});
  }
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  build();
  btn.addEventListener('click',function(){run(reduce);});
  function go(){if(started) return; started=true; run(reduce);}
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es,ob){if(es[0].isIntersecting){go(); ob.disconnect();}},{threshold:.3}).observe(root);
  } else { go(); }
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>
