---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Edupath SMS home">
            <span class="brand-mark">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                  stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            Edupath SMS
          </a>
        </div>
        <p class="footer-statement">Kenya’s CBE-ready school operating system.</p>
        <p class="footer-note">Unifying admissions, academics, fees, communication and compliance in one cloud platform.</p>
        <p class="footer-note">Built for Kenya · Data Protection Act (2019) Compliant</p>
      </div>

      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#portals">Portals</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/#campus">Campus</a></li>
          <li><a href="/cbe-school-management">CBE Management</a></li>
          <li><a href="/mpesa-school-fees">M-Pesa Fees</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Parents &amp; Schools</h4>
        <ul>
          <li><a href="/parent-portal">Parent Portal</a></li>
          <li><a href="/school-attendance">Attendance</a></li>
          <li><a href="/#register">Register School</a></li>
          <li><a href="https://app.edupath.co.ke/portal" target="_blank">Sign In</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Support</h4>
        <ul>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href="/#contact">Contact Us</a></li>
          <li><a href="mailto:admin@edupath.co.ke">Email Support</a></li>
          <li><a href="/#register">Get Started Free</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Edupath SMS · All rights reserved · Nairobi, Kenya</p>
