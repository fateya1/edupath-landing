---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/home.css';

// Structured data for search engines. Plan prices come from `plans`, so they cannot drift.
function buildJsonLd() {
  const site = 'https://www.edupath.co.ke';
  return JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${site}/#org`,
        name: 'Edupath SMS',
        url: site,
        contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'admin@edupath.co.ke', telephone: '+254711606968', areaServed: 'KE' },
      },
      { '@type': 'WebSite', '@id': `${site}/#website`, name: 'Edupath SMS', url: site, publisher: { '@id': `${site}/#org` } },
      {
        '@type': 'SoftwareApplication',
        name: 'Edupath SMS',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        url: site,
        description: 'All-in-one school management system for Kenyan schools: admissions, CBE report cards, timetables, fees and M-Pesa, accounts and payroll.',
        publisher: { '@id': `${site}/#org` },
        offers: plans
          .filter((p) => /\d/.test(String(p.price)))
          .map((p) => ({ '@type': 'Offer', name: p.name, price: Number(String(p.price).replace(/[^0-9]/g, '')), priceCurrency: 'KES', description: `${p.target}. Billed per term.` })),
      },
    ],
  });
}

const features = [
  { title: 'Student Management & Admissions', text: 'Profiles, CBE pathway assignment, classes and one-click Excel import.', href: null },
  { title: 'Assessments & Report Cards', text: 'CBE (EE/ME/AE/BE) and 8-4-4 grading with one-click PDF report cards.', href: '/cbe-school-management' },
  { title: 'Attendance Tracking', text: 'Mark in under two minutes from any device, with real-time parent alerts.', href: '/school-attendance' },
  { title: 'Fee Management & M-Pesa', text: 'STK push payments, balances and automatic receipts and statements.', href: '/mpesa-school-fees' },
  { title: 'Financial Reports', text: 'Collection rate, defaulters, class comparison, trial balance and cash book, with CSV and PDF downloads.', href: '/school-financial-reports' },
  { title: 'KEMIS Readiness', text: 'Check learner data, export a KEMIS registration worksheet and import UPI numbers back in bulk.', href: '/kemis-registration-readiness' },
  { title: 'Teacher & Staff Management', text: 'Profiles, TSC numbers, assignments and results integration.', href: null },
  { title: 'Timetable Builder', text: 'Generate clash-free timetables from your teaching requirements, then move lessons, cover absences, repair and print.', href: '/school-timetable-software' },
  { title: 'Hostel Management', text: 'Room allocations, capacity and check-in/out for boarding schools.', href: null },
  { title: 'Transport Management', text: 'Routes, bus assignments, drivers and parent pickup points.', href: null },
  { title: 'HR & Payroll', text: 'Salary setup, monthly payroll with PAYE, SHA, NSSF, Housing Levy and HELB, payslips, leave and staff records.', href: '/school-payroll-software' },
  { title: 'Procurement', text: 'Requisitions, purchase orders, receiving, supplier invoices, vote-head budgets and capitation in one place.', href: '/school-procurement-software' },
  { title: 'Announcements & Messaging', text: 'Broadcasts, parent-teacher chat and WhatsApp blasts.', href: null },
  { title: 'School Calendar & Events', text: 'Term calendars and events that auto-trigger notifications.', href: null },
  { title: 'Migration Hub', text: 'Bulk Excel import for students, fees, timetables and more.', href: null },
  { title: 'Library System', text: 'Catalogue, issue/return and overdue tracking.', href: null },
  { title: 'Assets & Facilities', text: 'Catalogue assets, maintenance history and assignments.', href: null },
  { title: 'Discipline Records', text: 'Incident logs and per-student history with admin oversight.', href: null },
];

const portals = [
  { name: 'Admin Portal', text: 'Admissions, fees, staff, analytics and settings.' },
  { name: 'Teacher Portal', text: 'Attendance, marks, timetable and messages.' },
  { name: 'Student Portal', text: 'Attendance, results, fees and schedule.' },
  { name: 'Parent Portal', text: 'Real-time updates, results and M-Pesa payments.', href: '/parent-portal' },
  { name: 'Regulator Portal', text: 'CDE, SCDE, CD-TSC and SCD-TSC read-access to compliance data.', href: null },
];

const plans = [
  { name: 'Free', price: 'KES 0', target: 'Up to 200 students', line: 'Admissions, attendance, timetables, fees and procurement.', features: ['Up to 200 students', 'Unlimited teachers', 'Admissions & attendance', 'Parent portal', 'Timetable builder', 'Fee management & reports', 'Procurement'], cta: 'Get Started Free', href: '/#register', featured: false },
  { name: 'Starter', price: 'KES 5,999', target: '200–400 students', line: 'Everything in Free, plus M-Pesa and WhatsApp.', features: ['All Free features', 'M-Pesa STK push', 'WhatsApp notifications', 'Custom branding', 'Library & assets'], cta: 'Register Your School', href: '/#register', featured: true, badge: 'Most popular' },
  { name: 'Pro', price: 'KES 12,999', target: '400–1,000 students', line: 'Everything in Starter, plus analytics and results.', features: ['All Starter features', 'Advanced analytics', 'Hostel & transport modules', 'School calendar & events', 'Priority support'], cta: 'Get Pro', href: '/#register', featured: false },
  { name: 'Enterprise', price: 'Custom', target: '1,000+ students', line: 'Everything in Pro, plus onboarding and API access.', features: ['All Pro features', 'HR & Payroll module', 'API access', 'Multi-campus support', 'County-level reporting', 'Dedicated onboarding'], cta: 'Contact Sales', href: 'mailto:admin@edupath.co.ke', featured: false, custom: true },
];

const testimonials = [
  { quote: 'We generate PDF report cards for 247 students in minutes. The CBE grading is accurate and parents love real-time access to results.', name: 'Juma Omar', role: 'Principal, Nairobi County', initials: 'JO' },
  { quote: 'Setup took under 10 minutes. We imported all our students from Excel and were live the same afternoon.', name: 'Amina Wanjiku', role: 'Deputy Principal, Mombasa County', initials: 'AW' },
  { quote: 'Fee tracking alone has saved us hours weekly. Parents pay via M-Pesa without calling us.', name: 'Moses Kamau', role: 'Bursar, Kisumu County', initials: 'MK' },
];

const campus = [
  'One school or a group — Edupath manages multiple campuses from a single login.',
  'Central oversight with per-campus settings, staff and reports.',
  'County-level and regulator reporting across all your campuses.',
];

const faqs = [
  ['How long does setup take?', 'Most schools are fully set up within 5–15 minutes. Register, receive your school code, then import students and teachers via the Excel bulk upload. Your dashboard is live immediately.'],
  ['Does Edupath support both CBE and 8-4-4?', 'Yes. Edupath was built from the ground up for Kenya\'s CBE curriculum with native support for all four senior-school pathways, and it also supports 8-4-4. Report cards generate correctly for either system.'],
  ['Can parents access information in real time?', 'Yes. Parents get a dedicated portal for attendance, results and fee balances, and can pay via M-Pesa STK push. They also receive WhatsApp and push alerts automatically.'],
  ['Is our school data secure and private?', 'Yes. Edupath is multi-tenant — every school\'s data is isolated by a unique School ID. All connections use HTTPS/TLS (256-bit), compliant with Kenya\'s Data Protection Act (2019).'],
  ['Is there a portal for the Ministry of Education or TSC?', 'Yes. The Regulator Portal gives County & Sub-County Directors of Education (CDE, SCDE) and TSC officials (CD-TSC, SCD-TSC) read-access to enrollment, staffing and compliance data — without exposing sensitive financial or student records.'],
  ['How does M-Pesa fee payment work?', 'Parents view the balance in the Parent Portal and click "Pay via M-Pesa." An STK push is sent to their phone, they confirm with their PIN, and the fee record updates automatically.'],
  ['Can I import our existing data?', 'Yes. The Migration Hub provides Excel templates for students, teachers, parents, assessments, timetables, fees, library books and assets — migrate your whole school in an afternoon.'],
  ['Does Edupath work on smartphones and offline?', 'Yes. The web app is fully responsive, and the Android app adds Swahili/English, biometric login, dark & light themes and offline mode.'],
  // EP:FAQITEMS:START
  ["What if the timetable can’t be solved with our rules?", "Edupath tells you which rules are in conflict instead of giving you a timetable that only looks valid. Usually one rule is too strict for the teachers or rooms you have, for example a teacher available on two days who is assigned five lessons. Change that rule from “must” to “prefer”, or adjust the availability, and generate again."],
  ["Can we still change the timetable by hand?", "Yes. Before generating, you can fix lessons in place, such as the Monday assembly or a fixed double period, and Edupath builds the rest around them. After generating, drag a lesson to a new slot. Slots that would cause a clash are blocked, and the last change can be undone with one click."],
  ["What if a teacher falls sick or a room is out of use mid-term?", "Mark the teacher or room as unavailable and re-generate only the affected lessons. The rest of the timetable your staff and parents already know stays where it is."],
  ["What if our student and teacher spreadsheets are messy?", "Use the Migration Hub Excel templates. Before anything is saved, the import lists the rows that need fixing, such as missing admission numbers or duplicate names, so you correct them in the sheet and upload again. If you get stuck, email admin@edupath.co.ke or WhatsApp +254 711 606 968 during office hours."],
  ["Where is our school’s data stored?", "Your school’s data is stored in a managed PostgreSQL database on Neon, a cloud database platform. Every school’s data is isolated by a unique School ID, connections use HTTPS/TLS, and Edupath follows Kenya’s Data Protection Act (2019)."],
  ["What if an M-Pesa payment doesn’t show on the fee statement?", "Most payments update as soon as the parent confirms with their PIN. If one doesn’t, ask the parent for the M-Pesa confirmation message and send us the reference code (it looks like QFJ2H4K)."],
  // EP:FAQITEMS:END
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
});
---

<Layout
  title="Edupath SMS — School management for Kenya's CBE"
  description="Edupath SMS is an all-in-one school management system for Kenyan schools: admissions, CBE report cards, timetables, fees and M-Pesa, accounts and payroll."
  path="/"
  ogTitle="Edupath SMS — School management for Kenya's CBE"
  ogDescription="Admissions, attendance, academics, fees and communication in one platform — built for Kenya's CBE curriculum, powered by M-Pesa."
  jsonLd={`[${buildJsonLd()},${faqJsonLd}]`}
  bodyClass="home"
>
  <Nav active="/" />

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-grid">
        <h1 class="hero-title">The paperless way to run your school.</h1>
        <div class="hero-side">
          <p class="hero-lead">From admissions and CBE report cards to timetables, fee collection, accounts and payroll, Edupath SMS runs your whole school in one place, with M-Pesa and WhatsApp built in.</p>
          <div class="hero-cta">
            <a class="btn btn--primary" href="/#register">Start Free — No Card Required</a>
            <a class="chip" href="https://app.edupath.co.ke/login?demo=1">View Live Demo →</a>
          </div>
          <p class="hero-trust">Built for Kenya's CBE · M-Pesa built in · Set up in 5 to 15 minutes</p>
        </div>
      </div>
    </section>

    <!-- TRUST LINE -->
    <div class="trust">
      <div class="trust-inner">
        <span class="trust-label">Why schools choose us</span>
        <span class="trust-items">
          <span class="trust-item">PAY IN SECONDS</span>
          <span class="trust-item">NO NEW APPS</span>
          <span class="trust-item">FREE UP TO 200 STUDENTS</span>
          <span class="trust-item">SET UP IN 5–15 MINUTES</span>
        </span>
      </div>
    </div>

    <!-- SHOW, DON'T TELL — familiar real notifications -->
    <section class="demo" id="demo">
      <div class="demo-inner">
        <h2 class="demo-title">The moments your parents already know.</h2>
        <p class="demo-lead">No new apps to download. Edupath works through M-Pesa and WhatsApp — the things every parent already uses every day.</p>
        <div class="demo-cards">
          <div class="phone-card" aria-hidden="true">
            <span class="pc-header">
              <span class="pc-brand"><span class="pc-dot pc-dot--m"></span>M-PESA</span>
              <span class="pc-now">now</span>
            </span>
            <span class="pc-amount">KES 5,999.00</span>
            <span class="pc-line">sent to <strong>Edupath School Ltd</strong></span>
            <span class="pc-line pc-ref">Ref: QFJ2H4K · Term 3 · 10 Aug 8:02 AM</span>
            <span class="pc-status">Payment received</span>
          </div>
          <div class="phone-card" aria-hidden="true">
            <span class="pc-header">
              <span class="pc-brand"><span class="pc-dot pc-dot--w"></span>WhatsApp</span>
              <span class="pc-now">now</span>
            </span>
            <span class="pc-to"><strong>Edupath SMS</strong> · Attendance alert</span>
            <span class="pc-line">Kevin Kamau was marked <strong class="pc-ok">Present</strong> today at 8:02 AM.</span>
            <span class="pc-line pc-ref">Term 3 · Week 1 · Greenfield Secondary School</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES — the full product, as a simple index -->
    <section class="sec" id="features">
      <div class="sec-inner">
        <h2 class="sec-title">Everything your school needs, in one place.</h2>
        <div class="idx-list">
          {features.map((f) => (
            <a class="idx-row" href={f.href ?? '/#features'} aria-label={f.title}>
              <span class="idx-name">{f.title}</span>
              <span class="idx-text">{f.text}</span>
              {f.href && <span class="idx-arrow" aria-hidden="true">→</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PORTALS -->
    <!-- EP:STYLE:START -->
<style is:global>#ep-solve,#ep-faq-new{--t:#0D9488;--td:#0F766E;--tdd:#134E4A;--tt:#F0FDFA;--tb:#CCE7E3;--ink:#0F2F2C;--mut:#4B6B67;--bad:#B91C1C;--badbg:#FEE2E2;--ind:#5A55E0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);box-sizing:border-box}
#ep-solve *,#ep-faq-new *{box-sizing:border-box}
#ep-solve{padding:0}
#ep-solve [hidden]{display:none!important}
.eps-wrap{max-width:1120px;margin:0 auto;display:grid;gap:36px;grid-template-columns:1fr;align-items:center}
@media(min-width:1000px){.eps-wrap{grid-template-columns:4fr 8fr;gap:44px}}
.eps-copy h3{font-size:clamp(1.4rem,2.6vw,1.9rem);line-height:1.15;margin:0 0 14px;color:var(--tdd);letter-spacing:-.01em}
.eps-copy p{margin:0 0 18px;line-height:1.6;color:var(--mut);max-width:46ch}
.eps-pts{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:10px}
.eps-pts li{display:flex;gap:10px;line-height:1.45;font-size:.95rem}
.eps-pts li::before{content:"\2713";flex:none;width:20px;height:20px;border-radius:50%;background:var(--t);color:#fff;font-size:.72rem;display:grid;place-items:center;margin-top:1px}
.eps-btn{appearance:none;border:0;background:var(--t);color:#fff;font:inherit;font-weight:600;padding:13px 22px;border-radius:10px;cursor:pointer;min-height:46px}
.eps-btn:hover:not(:disabled){background:var(--td)}
.eps-btn:disabled{opacity:.6;cursor:progress}
#ep-solve :focus-visible,#ep-faq-new :focus-visible{outline:3px solid var(--tdd);outline-offset:3px}
.eps-panel{position:relative;overflow:hidden;background:#fff;border:1px solid var(--tb);border-radius:14px;padding:14px;box-shadow:0 10px 30px rgba(19,78,74,.08)}
.eps-hd{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.eps-hd b{display:block;font-size:1.05rem;color:#111}
.eps-hd span{font-size:.72rem;color:#6B7A99}
.eps-hd .yr{text-align:right}
.eps-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px}
.eps-sc{border-radius:12px;padding:10px 12px;border:1px solid}
.eps-sc b{display:block;font-size:1.35rem;line-height:1.1;font-variant-numeric:tabular-nums}
.eps-sc span{font-size:.68rem;color:#4B5563}
.eps-sc.a{background:#E8F0FE;border-color:#C7D8F8}.eps-sc.a b{color:#3B6FE0}
.eps-sc.b{background:#EFEAFB;border-color:#D8CCF5}.eps-sc.b b{color:#7C5CE0}
.eps-sc.c{background:#E3F6F1;border-color:#BDE6DA}.eps-sc.c b{color:#16A394}
.eps-sc.d{background:#FDF1E3;border-color:#F3D9B4}.eps-sc.d b{color:#E8912D}
.eps-view{display:flex;align-items:center;gap:8px;font-size:.74rem;margin-bottom:8px}
.eps-tbar{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.eps-tb{font-size:.7rem;padding:7px 10px;border-radius:9px;border:1px solid #E1E4F2;background:#fff;color:#2B2F52;transition:transform .15s}
.eps-tb.mv{background:#3B6FE0;color:#fff;border-color:#3B6FE0}
.eps-tb.gn{background:#0FA67E;color:#fff;border-color:#0FA67E}
.eps-hint{font-size:.66rem;color:#8A94A6;margin:0 0 10px}
.press{transform:scale(.95)}
.eps-scroll{overflow-x:auto;overflow-y:hidden}
.eps-grid{display:grid;grid-template-columns:104px repeat(5,minmax(0,1fr));gap:6px;min-width:640px}
.eps-h{font-size:.7rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:6px 4px;display:flex;align-items:center}
.eps-per{display:flex;flex-direction:column;justify-content:center;padding-left:4px}
.eps-per b{font-size:.78rem}
.eps-per .eps-t{font-size:.68rem;color:var(--mut)}
.eps-brk{display:flex;align-items:center;font-size:.68rem;color:var(--mut);padding-left:4px;letter-spacing:.04em;text-transform:uppercase}
.eps-brkt{grid-column:2/-1;text-align:center;font-size:.72rem;color:var(--mut);background:#F3F8F7;border-radius:6px;padding:6px}
.eps-cell{position:relative;min-height:46px;border:1px dashed var(--tb);border-radius:8px;padding:5px 18px 5px 8px;display:flex;flex-direction:column;justify-content:center;gap:1px;background:#fff;overflow:hidden}
.eps-cell b{font-size:.74rem;line-height:1.2;font-weight:600;color:var(--c)}
.eps-cell i{font-size:.66rem;font-style:normal;color:var(--c);opacity:.75}
.eps-cell.on{border:1.5px solid var(--c);animation:epsPop .22s ease-out}
.eps-cell.on::after{content:"\00d7";position:absolute;top:3px;right:7px;font-size:.72rem;color:var(--c)}
.eps-cell.bad{background:var(--badbg);border:1.5px solid var(--bad);animation:epsShake .3s}
.eps-s{display:none}
.eps-log{margin-top:10px;min-height:2.4em;font-size:.82rem;line-height:1.4;color:var(--mut)}
.eps-log.bad{color:var(--bad)}
.eps-modal{position:absolute;inset:0;z-index:6;background:rgba(15,23,42,.45);display:none;align-items:flex-start;justify-content:center;padding:56px 14px 14px}
.eps-modal.on{display:flex;animation:epsFade .2s ease-out}
.eps-dlg{width:min(100%,540px);max-height:100%;overflow:hidden;background:#fff;border-radius:14px;padding:16px;box-shadow:0 20px 50px rgba(0,0,0,.3)}
.eps-d{display:none}
.eps-d.on{display:block;animation:epsIn .25s ease-out}
.eps-d h4{margin:0 0 4px;font-size:1rem;color:#111}
.eps-dd{margin:0 0 10px;font-size:.68rem;color:#8A94A6;line-height:1.5}
.eps-ft{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-top:12px}
.eps-b2{display:inline-block;font-size:.7rem;padding:7px 12px;border-radius:8px;border:1px solid #E1E4F2;background:#fff;color:#2B2F52;transition:transform .15s,background .3s}
.eps-b2.dk{background:#6B7280;color:#fff;border-color:#6B7280}
.eps-b2.gr{background:#0FA67E;color:#fff;border-color:#0FA67E}
.eps-b2.ok{background:#DCFCE7;border-color:#86D9A5;color:#15803D}
.eps-inp{min-height:30px;padding:6px 9px;border:1px solid #E1E4F2;border-radius:8px;font-size:.74rem;background:#fff;display:flex;align-items:center;color:#111}
.eps-inp:empty::before{content:attr(data-ph);color:#9AA3B2}
.eps-inp.typing::after{content:"";width:1px;height:1em;background:#111;margin-left:1px;animation:epsBlink 1s steps(1) infinite}
.eps-tb2{width:100%;border-collapse:collapse;font-size:.7rem}
.eps-tb2 th{text-align:left;padding:5px;color:#8A94A6;font-weight:600;font-size:.62rem}
.eps-tb2 td{padding:6px 5px;border-top:1px solid #EEF0F8}
.eps-tb2 tr.hl td{background:#FFF7DB}
.eps-add{display:grid;grid-template-columns:2fr 1.3fr 1fr auto;gap:6px;margin-bottom:8px}
.eps-li{display:grid;grid-template-columns:2fr 1.3fr auto;gap:6px;padding:6px 0;border-top:1px solid #EEF0F8;font-size:.72rem;color:#111}
.eps-li span:nth-child(2){color:var(--mut)}
.eps-li.new{background:#ECFDF3;animation:epsIn .3s ease-out}
.eps-pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;align-items:center}
.eps-pill{font-size:.7rem;padding:6px 10px;border-radius:8px;border:1px solid #E1E4F2;background:#fff;color:#2B2F52}
.eps-pill.on{border-color:#3B6FE0;color:#3B6FE0}
.eps-av{display:grid;grid-template-columns:34px repeat(5,1fr);gap:4px;margin-top:8px;font-size:.62rem;color:var(--mut)}
.eps-av div{display:flex;align-items:center;justify-content:center;min-height:20px}
.eps-ac{background:#D9F5E6;border-radius:5px;transition:background .3s}
.eps-ac.off{background:#E5E7EB;box-shadow:inset 0 0 0 1px #CBD5E1}
.eps-rr{display:grid;grid-template-columns:1.4fr 1.4fr auto;gap:6px;padding:6px 0;border-top:1px solid #EEF0F8;font-size:.72rem;color:#111}
.eps-rr span{color:var(--mut)}
.eps-sum{margin-top:8px;font-size:.72rem;color:#15803D;font-weight:600}
.eps-ok{background:#0B5B4F;color:#fff;border-radius:8px;padding:10px 12px;font-size:.76rem;font-weight:600;margin-bottom:10px}
.eps-k{font-size:.62rem;letter-spacing:.06em;color:#8A94A6;margin:8px 0 3px;font-weight:600}
.eps-ch{font-size:.76rem;color:var(--mut);padding:14px 0}
.eps-cls{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:8px}
.eps-cc{position:relative;border:1px solid #E6E8F5;border-radius:10px;padding:8px 10px 8px 30px;font-size:.68rem;color:#8A94A6;transition:background .3s,border-color .3s}
.eps-cc b{display:block;color:#111;font-size:.72rem}
.eps-cc i{position:absolute;left:9px;top:11px;width:13px;height:13px;border:1.5px solid #9AA3B2;border-radius:3px;display:grid;place-items:center;font-style:normal;font-size:.55rem;color:#fff}
.eps-cc.on{border-color:#3B6FE0;background:#F3F7FF}.eps-cc.on i{background:#3B6FE0;border-color:#3B6FE0}.eps-cc.on i::after{content:"\2713"}
.eps-rad{font-size:.72rem;color:#111;display:flex;gap:7px;align-items:center;margin:3px 0}
.eps-rad::before{content:"";width:11px;height:11px;border-radius:50%;border:1.5px solid #9AA3B2}
.eps-rad.on::before{border-color:#3B6FE0;background:radial-gradient(#3B6FE0 45%,#fff 50%)}
.eps-mb{display:grid;grid-template-columns:44px repeat(3,1fr);gap:5px;font-size:.62rem;color:var(--mut)}
