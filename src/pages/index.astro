.epp-c .id{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.58rem;color:#6B7280}
.epp-c b{display:block;font-size:.8rem;color:#111;margin:2px 0}
.epp-c small{display:block;font-size:.62rem;color:#6B7280}
.epp-c .bot{display:flex;justify-content:space-between;align-items:center;margin-top:7px}
.epp-c .bot strong{font-size:.9rem;color:#111}
.epp-chip{display:inline-block;font-style:normal;font-size:.58rem;font-weight:700;padding:2px 8px;border-radius:99px;margin-left:4px}
.epp-chip.ok{background:#DCFCE7;color:#15803D}.epp-chip.wn{background:#FEF3C7;color:#B45309}.epp-chip.ov{background:#FEE2E2;color:#DC2626}.epp-chip.nm{background:#EFF6FF;color:#2563EB}.epp-chip.tg{background:#FEF3C7;color:#92400E}
.epp-b{display:inline-block;font-size:.66rem;font-weight:700;padding:6px 11px;border-radius:8px;border:1px solid #C4B5FD;background:#fff;color:#6D28D9;white-space:nowrap;transition:transform .15s,background .3s}
.epp-b.bl{background:#3B82F6;border-color:#3B82F6;color:#fff}
.epp-b.pu{background:var(--pu);border-color:var(--pu);color:#fff}
.epp-b.done{background:#15803D;border-color:#15803D;color:#fff}
.epp-sec{font-size:.8rem;font-weight:700;color:#111;margin:0 0 8px}
.epp-sc{overflow-x:auto;overflow-y:hidden}
.epp-t{width:100%;min-width:560px;border-collapse:collapse;font-size:.64rem;color:#111}
.epp-t th{text-align:left;padding:6px 5px;font-weight:600;color:#475569}
.epp-t td{padding:7px 5px;border-top:1px solid #F1F2F6;vertical-align:middle}
.epp-t td b{font-size:.68rem}.epp-t td small{display:block;color:#8A94A6;font-size:.56rem;text-transform:uppercase}
.epp-bar{height:7px;background:#E5E7EB;border-radius:4px;overflow:hidden;min-width:70px}
.epp-bar i{display:block;height:100%;width:0;background:#22C55E;border-radius:4px;transition:width .9s ease-out}
.epp-bar i.hot{background:#F59E0B}
.epp-form{display:grid;grid-template-columns:repeat(3,1fr);gap:8px 10px}
.epp-form label{display:block;font-size:.58rem;font-weight:600;color:#475569;margin-bottom:3px}
.epp-inp{min-height:28px;padding:5px 8px;border:1px solid #E1E4F2;border-radius:7px;font-size:.66rem;background:#fff;display:flex;align-items:center;color:#111}
.epp-inp.typing::after{content:"";width:1px;height:1em;background:#111;margin-left:1px;animation:eppBlink 1s steps(1) infinite}
.epp-tot{display:flex;gap:12px;align-items:center;margin-top:10px;font-size:.72rem;font-weight:700;color:#111}
.epp-ok{margin-top:8px;font-size:.7rem;font-weight:600;color:#15803D;background:#ECFDF3;border:1px solid #A7E3BF;border-radius:8px;padding:7px 10px;animation:eppIn .35s ease-out}
.epp-k6{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:10px}
.epp-kc{border:1px solid #EEF0F4;border-left:4px solid var(--kc);border-radius:10px;padding:8px 9px;background:#fff}
.epp-kc span{display:block;font-size:.58rem;color:#6B7280}
.epp-kc b{display:block;font-size:1rem;color:var(--kc);font-variant-numeric:tabular-nums;margin-top:3px}
.epp-box{border:1px solid #EEF0F4;border-radius:12px;padding:12px}
.epp-sp{display:flex;justify-content:space-between;font-size:.7rem;font-weight:600;color:#111;margin:8px 0 4px}
.epp-sp span{font-weight:500;color:#475569}
.epp-sb{height:7px;background:#E5E7EB;border-radius:4px;overflow:hidden}
.epp-sb i{display:block;height:100%;width:0;background:#8B5CF6;border-radius:4px;transition:width 1s ease-out}
.epp-cur{position:absolute;left:0;top:0;z-index:9;pointer-events:none;transition:transform .6s cubic-bezier(.4,0,.2,1),opacity .4s;opacity:0}
.epp-cur.vis{opacity:1}
.epp-cur svg{display:block;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35))}
.epp-cur i{position:absolute;left:-8px;top:-8px;width:20px;height:20px;border-radius:50%;border:2px solid var(--pu);opacity:0}
.epp-cur.click i{animation:eppRip .45s ease-out}
.epp-note{margin:10px 0 0;font-size:.78rem;color:var(--mut)}
.epp-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@keyframes eppIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@keyframes eppRip{from{transform:scale(.3);opacity:.9}to{transform:scale(1.6);opacity:0}}
@keyframes eppBlink{50%{opacity:0}}
@media(prefers-reduced-motion:reduce){.epp-v.show,.epp-ok{animation:none}.epp-cur{display:none}.epp-bar i,.epp-sb i{transition:none}}
@media(max-width:640px){
.epp-app{padding:12px}
.epp-sc{overflow:visible}.epp-t{min-width:0}
.epp-m{display:none!important}
.epp-xs{display:none!important}
.epp-form{grid-template-columns:1fr 1fr}
.epp-k6{grid-template-columns:1fr 1fr 1fr}
.epp-views{min-height:380px}
.epp-tab{padding:7px 7px;font-size:.62rem}
}
