---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/home.css';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Edupath SMS',
  url: 'https://www.edupath.co.ke',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://www.edupath.co.ke/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
});

const features = [
  { title: 'Student Management & Admissions', text: 'Profiles, CBE pathway assignment, classes and one-click Excel import.', href: null },
  { title: 'Assessments & Report Cards', text: 'CBE (EE/ME/AE/BE) and 8-4-4 grading with one-click PDF report cards.', href: '/cbe-school-management' },
  { title: 'Attendance Tracking', text: 'Mark in under two minutes from any device, with real-time parent alerts.', href: '/school-attendance' },
  { title: 'Fee Management & M-Pesa', text: 'STK push payments, balances and automatic receipts and statements.', href: '/mpesa-school-fees' },
  { title: 'Teacher & Staff Management', text: 'Profiles, TSC numbers, assignments and results integration.', href: null },
  { title: 'Timetable Builder', text: 'Assign periods, bulk import from Excel, personalised weekly schedules.', href: null },
  { title: 'Hostel Management', text: 'Room allocations, capacity and check-in/out for boarding schools.', href: null },
  { title: 'Transport Management', text: 'Routes, bus assignments, drivers and parent pickup points.', href: null },
  { title: 'HR & Payroll', text: 'Contracts, pay runs, SHA/NSSF/PAYE, payslips and leave.', href: null },
  { title: 'Announcements & Messaging', text: 'Broadcasts, parent-teacher chat and WhatsApp blasts.', href: null },
  { title: 'School Calendar & Events', text: 'Term calendars and events that auto-trigger notifications.', href: null },
  { title: 'Migration Hub', text: 'Bulk Excel import for students, fees, timetables and more.', href: null },
  { title: 'Library System', text: 'Catalogue, issue/return and overdue tracking.', href: null },
  { title: 'Assets & Facilities', text: 'Catalogue assets, maintenance history and assignments.', href: null },
  { title: 'Discipline Records', text: 'Incident logs and per-student history with admin oversight.', href: null },
];

const portals = [
  { name: 'Admin Portal', text: 'Admissions, fees, staff, analytics and settings.' },
  { name: 'Teacher Portal', text: 'Attendance, marks, timetable and messages.' },
  { name: 'Student Portal', text: 'Attendance, results, fees and schedule.' },
  { name: 'Parent Portal', text: 'Real-time updates, results and M-Pesa payments.', href: '/parent-portal' },
  { name: 'Regulator Portal', text: 'CDE, SCDE, CD-TSC and SCD-TSC read-access to compliance data.', href: null },
];

const plans = [
  { name: 'Free', price: 'KES 0', target: 'Up to 200 students', line: 'Admissions, attendance and parent portal.', features: ['Up to 200 students', 'Unlimited teachers', 'Admissions & attendance', 'Parent portal'], cta: 'Get Started Free', href: '/#register', featured: false },
  { name: 'Starter', price: 'KES 5,999', target: '200–400 students', line: 'Everything in Free, plus M-Pesa and WhatsApp.', features: ['All Free features', 'M-Pesa STK push', 'WhatsApp notifications', 'Custom branding', 'Full fee management', 'Library & assets'], cta: 'Register Your School', href: '/#register', featured: true, badge: 'Most popular' },
  { name: 'Pro', price: 'KES 12,999', target: '400–1,000 students', line: 'Everything in Starter, plus analytics and results.', features: ['All Starter features', 'Advanced analytics', 'Full timetable management', 'Hostel & transport modules', 'School calendar & events', 'Priority support'], cta: 'Get Pro', href: '/#register', featured: false },
  { name: 'Enterprise', price: 'Custom', target: '1,000+ students', line: 'Everything in Pro, plus onboarding and API access.', features: ['All Pro features', 'HR & Payroll module', 'API access', 'Multi-campus support', 'County-level reporting', 'Dedicated onboarding'], cta: 'Contact Sales', href: 'mailto:admin@edupath.co.ke', featured: false, custom: true },
];

const testimonials = [
  { quote: 'We generate PDF report cards for 247 students in minutes. The CBE grading is accurate and parents love real-time access to results.', name: 'Juma Omar', role: 'Principal, Nairobi County', initials: 'JO' },
  { quote: 'Setup took under 10 minutes. We imported all our students from Excel and were live the same afternoon.', name: 'Amina Wanjiku', role: 'Deputy Principal, Mombasa County', initials: 'AW' },
  { quote: 'Fee tracking alone has saved us hours weekly. Parents pay via M-Pesa without calling us.', name: 'Moses Kamau', role: 'Bursar, Kisumu County', initials: 'MK' },
];

const campus = [
  'One school or a group — Edupath manages multiple campuses from a single login.',
  'Central oversight with per-campus settings, staff and reports.',
  'County-level and regulator reporting across all your campuses.',
];

const faqs = [
  ['How long does setup take?', 'Most schools are fully set up within 5–15 minutes. Register, receive your school code, then import students and teachers via the Excel bulk upload. Your dashboard is live immediately.'],
  ['Does Edupath support both CBE and 8-4-4?', 'Yes. Edupath was built from the ground up for Kenya\'s CBE curriculum with native support for all four senior-school pathways, and it also supports 8-4-4. Report cards generate correctly for either system.'],
  ['Can parents access information in real time?', 'Yes. Parents get a dedicated portal for attendance, results and fee balances, and can pay via M-Pesa STK push. They also receive WhatsApp and push alerts automatically.'],
  ['Is our school data secure and private?', 'Yes. Edupath is multi-tenant — every school\'s data is isolated by a unique School ID. All connections use HTTPS/TLS (256-bit), compliant with Kenya\'s Data Protection Act (2019).'],
  ['Is there a portal for the Ministry of Education or TSC?', 'Yes. The Regulator Portal gives County & Sub-County Directors of Education (CDE, SCDE) and TSC officials (CD-TSC, SCD-TSC) read-access to enrollment, staffing and compliance data — without exposing sensitive financial or student records.'],
  ['How does M-Pesa fee payment work?', 'Parents view the balance in the Parent Portal and click "Pay via M-Pesa." An STK push is sent to their phone, they confirm with their PIN, and the fee record updates automatically.'],
  ['Can I import our existing data?', 'Yes. The Migration Hub provides Excel templates for students, teachers, parents, assessments, timetables, fees, library books and assets — migrate your whole school in an afternoon.'],
  ['Does Edupath work on smartphones and offline?', 'Yes. The web app is fully responsive, and the Android app adds Swahili/English, biometric login, dark & light themes and offline mode.'],
  // EP:FAQITEMS:START
  ["What if the timetable can’t be solved with our rules?", "Edupath tells you which rules are in conflict instead of giving you a timetable that only looks valid. Usually one rule is too strict for the teachers or rooms you have, for example a teacher available on two days who is assigned five lessons. Change that rule from “must” to “prefer”, or adjust the availability, and generate again."],
  ["Can we still change the timetable by hand?", "Yes. Before generating, you can fix lessons in place, such as the Monday assembly or a fixed double period, and Edupath builds the rest around them. After generating, drag a lesson to a new slot. Slots that would cause a clash are blocked, and the last change can be undone with one click."],
  ["What if a teacher falls sick or a room is out of use mid-term?", "Mark the teacher or room as unavailable and re-generate only the affected lessons. The rest of the timetable your staff and parents already know stays where it is."],
  ["What if our student and teacher spreadsheets are messy?", "Use the Migration Hub Excel templates. Before anything is saved, the import lists the rows that need fixing, such as missing admission numbers or duplicate names, so you correct them in the sheet and upload again. If you get stuck, email admin@edupath.co.ke or WhatsApp +254 711 606 968 during office hours."],
  ["Where is our school’s data stored?", "Your school’s data is stored in a managed PostgreSQL database on Neon, a cloud database platform. Every school’s data is isolated by a unique School ID, connections use HTTPS/TLS, and Edupath follows Kenya’s Data Protection Act (2019)."],
  ["What if an M-Pesa payment doesn’t show on the fee statement?", "Most payments update as soon as the parent confirms with their PIN. If one doesn’t, ask the parent for the M-Pesa confirmation message and send us the reference code (it looks like QFJ2H4K)."],
  // EP:FAQITEMS:END
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
});
---

<Layout
  title="Edupath SMS — School management for Kenya's CBE"
  description="Edupath SMS is an all-in-one school management platform for Kenyan schools — CBE-ready, with M-Pesa fee collection and WhatsApp notifications built in."
  path="/"
  ogTitle="Edupath SMS — School management for Kenya's CBE"
  ogDescription="Admissions, attendance, academics, fees and communication in one platform — built for Kenya's CBE curriculum, powered by M-Pesa."
  jsonLd={`[${jsonLd},${faqJsonLd}]`}
  bodyClass="home"
>
  <Nav active="/" />

  <main id="main">
    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="hero-grid">
        <h1 class="hero-title">The paperless way to run your school.</h1>
        <div class="hero-side">
          <p class="hero-lead">Edupath SMS brings admissions, attendance, academics and fees into one all-in-one platform — built for Kenya's CBE curriculum, with M-Pesa and WhatsApp built in.</p>
          <div class="hero-cta">
            <a class="btn btn--primary" href="/#register">Start Free — No Card Required</a>
            <a class="chip" href="https://app.edupath.co.ke/login?demo=1">View Live Demo →</a>
          </div>
          <p class="hero-trust">Built for Kenya's CBE · M-Pesa built in · Live in about 5 minutes</p>
        </div>
      </div>
    </section>

    <!-- TRUST LINE -->
    <div class="trust">
      <div class="trust-inner">
        <span class="trust-label">Why schools choose us</span>
        <span class="trust-items">
          <span class="trust-item">PAY IN SECONDS</span>
          <span class="trust-item">NO NEW APPS</span>
          <span class="trust-item">SAVE 20+ HRS/WEEK</span>
          <span class="trust-item">LIVE IN 5 MINUTES</span>
        </span>
      </div>
    </div>

    <!-- SHOW, DON'T TELL — familiar real notifications -->
    <section class="demo" id="demo">
      <div class="demo-inner">
        <h2 class="demo-title">The moments your parents already know.</h2>
        <p class="demo-lead">No new apps to download. Edupath works through M-Pesa and WhatsApp — the things every parent already uses every day.</p>
        <div class="demo-cards">
          <div class="phone-card" aria-hidden="true">
            <span class="pc-header">
              <span class="pc-brand"><span class="pc-dot pc-dot--m"></span>M-PESA</span>
              <span class="pc-now">now</span>
            </span>
            <span class="pc-amount">KES 5,999.00</span>
            <span class="pc-line">sent to <strong>Edupath School Ltd</strong></span>
            <span class="pc-line pc-ref">Ref: QFJ2H4K · Term 3 · 10 Aug 8:02 AM</span>
            <span class="pc-status">Payment received</span>
          </div>
          <div class="phone-card" aria-hidden="true">
            <span class="pc-header">
              <span class="pc-brand"><span class="pc-dot pc-dot--w"></span>WhatsApp</span>
              <span class="pc-now">now</span>
            </span>
            <span class="pc-to"><strong>Edupath SMS</strong> · Attendance alert</span>
            <span class="pc-line">Kevin Kamau was marked <strong class="pc-ok">Present</strong> today at 8:02 AM.</span>
            <span class="pc-line pc-ref">Term 3 · Week 1 · Greenfield Secondary School</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES — the full product, as a simple index -->
    <!-- EP:STYLE:START -->
<style is:global>#ep-solve,#ep-faq-new{--t:#0D9488;--td:#0F766E;--tdd:#134E4A;--tt:#F0FDFA;--tb:#CCE7E3;--ink:#0F2F2C;--mut:#4B6B67;--bad:#B91C1C;--badbg:#FEE2E2;
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);box-sizing:border-box}
#ep-solve *,#ep-faq-new *{box-sizing:border-box}
#ep-solve{background:var(--tt);padding:72px 20px}
.eps-wrap{max-width:1120px;margin:0 auto;display:grid;gap:36px;grid-template-columns:1fr;align-items:start}
@media(min-width:960px){.eps-wrap{grid-template-columns:5fr 7fr;gap:48px}}
.eps-copy h2{font-size:clamp(1.7rem,3.2vw,2.35rem);line-height:1.15;margin:0 0 14px;color:var(--tdd);letter-spacing:-.01em}
.eps-copy p{margin:0 0 18px;line-height:1.6;color:var(--mut);max-width:46ch}
.eps-rules{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:10px}
.eps-rules li{display:flex;gap:10px;align-items:flex-start;line-height:1.45;font-size:.95rem}
.eps-tag{flex:none;font-size:.75rem;font-weight:700;padding:2px 8px;border-radius:99px;margin-top:2px;background:var(--tdd);color:#fff}
.eps-tag.soft{background:#fff;color:var(--td);border:1px solid var(--t)}
.eps-btn{appearance:none;border:0;background:var(--t);color:#fff;font:inherit;font-weight:600;padding:13px 22px;border-radius:10px;cursor:pointer;min-height:46px}
.eps-btn:hover:not(:disabled){background:var(--td)}
.eps-btn:disabled{opacity:.6;cursor:progress}
#ep-solve :focus-visible,#ep-faq-new :focus-visible{outline:3px solid var(--tdd);outline-offset:3px}
.eps-stats{display:flex;gap:26px;flex-wrap:wrap;margin-top:26px}
.eps-stat b{display:block;font-size:1.9rem;line-height:1;color:var(--tdd);font-variant-numeric:tabular-nums}
.eps-stat span{font-size:.82rem;color:var(--mut)}
.eps-stat.ok b{color:var(--td)}
.eps-panel{background:#fff;border:1px solid var(--tb);border-radius:14px;padding:16px;box-shadow:0 10px 30px rgba(19,78,74,.08)}
.eps-bar{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px;font-size:.9rem}
.eps-bar strong{color:var(--tdd)}
.eps-bar span{color:var(--mut)}
.eps-scroll{overflow-x:auto;overflow-y:hidden}
.eps-s{display:none}
.eps-grid{display:grid;grid-template-columns:104px repeat(5,minmax(0,1fr));gap:6px;min-width:700px}
.eps-h{font-size:.7rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:6px 4px;display:flex;align-items:center}
.eps-per{display:flex;flex-direction:column;justify-content:center;padding-left:4px}
.eps-per b{font-size:.78rem}
.eps-per .eps-t{font-size:.68rem;color:var(--mut)}
.eps-brk{display:flex;align-items:center;font-size:.68rem;color:var(--mut);padding-left:4px;letter-spacing:.04em;text-transform:uppercase}
.eps-brkt{grid-column:2/-1;text-align:center;font-size:.72rem;color:var(--mut);background:#F3F8F7;border-radius:6px;padding:7px}
.eps-cell{position:relative;min-height:50px;border:1px dashed var(--tb);border-radius:8px;padding:6px 18px 6px 8px;display:flex;flex-direction:column;justify-content:center;gap:1px;background:#fff;overflow:hidden}
.eps-cell b{font-size:.74rem;line-height:1.2;font-weight:600;color:var(--c)}
.eps-cell i{font-size:.66rem;font-style:normal;color:var(--c);opacity:.75}
.eps-cell.on{border:1.5px solid var(--c);animation:epsPop .22s ease-out}
.eps-cell.on::after{content:"\00d7";position:absolute;top:3px;right:7px;font-size:.72rem;color:var(--c)}
.eps-cell.bad{background:var(--badbg);border:1.5px solid var(--bad);animation:epsShake .3s}
@keyframes epsPop{from{transform:scale(.9);opacity:.3}to{transform:none;opacity:1}}
@keyframes epsShake{25%{transform:translateX(-3px)}75%{transform:translateX(3px)}}
.eps-log{margin-top:12px;min-height:2.6em;font-size:.88rem;line-height:1.4;color:var(--mut)}
.eps-log.bad{color:var(--bad)}
.eps-note{margin:10px 0 0;font-size:.78rem;color:var(--mut)}
.eps-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media(prefers-reduced-motion:reduce){.eps-cell.on,.eps-cell.bad{animation:none}}

@media(max-width:640px){
#ep-solve{padding:48px 16px}
.eps-panel{padding:10px}
.eps-scroll{overflow:visible}
.eps-grid{grid-template-columns:34px repeat(5,minmax(0,1fr));gap:3px;min-width:0}
.eps-h{font-size:.56rem;letter-spacing:0;padding:4px 0;justify-content:center;overflow:hidden}
.eps-f{display:none}.eps-s{display:inline}
.eps-t,.eps-cell i,.eps-cell.on::after{display:none}
.eps-cell{min-height:34px;padding:3px 2px;border-radius:6px;align-items:center;text-align:center}
.eps-cell b{font-size:.6rem}
.eps-per{padding-left:0;align-items:center}
.eps-per b{font-size:.62rem}
.eps-brk{font-size:.55rem;padding-left:0}
.eps-brkt{font-size:.62rem;padding:4px}
}
#ep-fees{--ind:#5A55E0;--lav:#EEF0FB;--ink:#0F2F2C;--mut:#5B6B7A;--t:#0D9488;--tdd:#134E4A;background:#F6F7FD;padding:72px 20px;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);box-sizing:border-box}
#ep-fees *{box-sizing:border-box}
#ep-fees [hidden]{display:none!important}
.epm-wrap{max-width:1120px;margin:0 auto;display:grid;gap:36px;grid-template-columns:1fr;align-items:center}
@media(min-width:1000px){.epm-wrap{grid-template-columns:4fr 8fr;gap:44px}}
.epm-copy h2{font-size:clamp(1.7rem,3.2vw,2.35rem);line-height:1.15;margin:0 0 14px;color:var(--tdd);letter-spacing:-.01em}
.epm-copy p{margin:0 0 18px;line-height:1.6;color:var(--mut);max-width:46ch}
.epm-pts{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:10px}
.epm-pts li{display:flex;gap:10px;line-height:1.45;font-size:.95rem}
.epm-pts li::before{content:"\2713";flex:none;width:20px;height:20px;border-radius:50%;background:var(--t);color:#fff;font-size:.72rem;display:grid;place-items:center;margin-top:1px}
.epm-go{appearance:none;border:0;background:var(--t);color:#fff;font:inherit;font-weight:600;padding:13px 22px;border-radius:10px;cursor:pointer;min-height:46px}
.epm-go:hover:not(:disabled){background:#0F766E}
.epm-go:disabled{opacity:.6;cursor:progress}
#ep-fees :focus-visible{outline:3px solid var(--tdd);outline-offset:3px}
.epm-app{position:relative;overflow:hidden;background:#fff;border:1px solid #E3E6F6;border-radius:16px;padding:14px;box-shadow:0 12px 32px rgba(67,56,202,.10)}
.epm-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:12px}
.epm-card{background:#fff;border:1px solid #E6E8F5;border-radius:12px;padding:12px 14px;box-shadow:0 2px 10px rgba(90,85,224,.06)}
.epm-card span{display:block;font-size:.75rem;color:var(--mut)}
.epm-card b{display:block;margin-top:4px;font-size:clamp(1.05rem,2.2vw,1.55rem);font-variant-numeric:tabular-nums;white-space:nowrap}
.epm-card .g{color:#16A34A}.epm-card .r{color:#DC2626}
.epm-tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.epm-tab{font-size:.74rem;font-weight:600;padding:7px 11px;border-radius:9px;background:var(--lav);color:#2B2F52;transition:background .25s,color .25s,transform .15s}
.epm-tab.on{background:var(--ind);color:#fff}
.press{transform:scale(.95)}
.epm-views{min-height:392px}
.epm-v{display:none}
.epm-v.show{display:block;animation:epmIn .35s ease-out}
.epm-feed{display:flex;align-items:center;gap:8px;min-height:38px;padding:8px 12px;border-radius:10px;background:#F4F5FB;border:1px solid #E6E8F5;font-size:.8rem;margin-bottom:12px;transition:background .3s,border-color .3s}
.epm-feed::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;background:#94A3B8}
.epm-feed.pay{background:#ECFDF3;border-color:#A7E3BF}.epm-feed.pay::before{background:#16A34A}
.epm-feed span{animation:epmIn .3s ease-out}
.epm-scroll{overflow-x:auto;overflow-y:hidden}
.epm-tbl{width:100%;min-width:720px;border-collapse:collapse;font-size:.74rem}
.epm-tbl th{text-align:left;font-weight:700;padding:8px 6px;color:#1E2140;background:#F6F7FC}
.epm-tbl td{padding:9px 6px;border-top:1px solid #EEF0F8;white-space:nowrap;transition:background .4s}
.epm-tbl tr.flash td{background:#EEF0FF}
.epm-pd{color:#16A34A}.epm-bl{color:#DC2626}
.epm-chip{display:inline-flex;align-items:center;gap:5px;font-size:.66rem;font-weight:700;padding:4px 9px;border-radius:7px}
.epm-chip::before{content:"";width:8px;height:8px;border-radius:50%;border:1.5px solid currentColor}
.epm-chip.PAID{background:#DCFCE7;color:#15803D}.epm-chip.PARTIAL{background:#FEF3C7;color:#B45309}.epm-chip.UNPAID{background:#FEE2E2;color:#B91C1C}
.epm-chip.pop{animation:epmPop .35s ease-out}
.epm-act{font-size:.68rem;font-weight:600;padding:4px 9px;border-radius:7px;background:#E6EAFB;color:#3730A3}
.epm-box{background:#fff;border:1px solid #E6E8F5;border-radius:12px;padding:14px;margin-bottom:10px}
.epm-box h4{margin:0 0 6px;font-size:.95rem;color:#111}
.epm-d{margin:0 0 10px;font-size:.72rem;color:var(--mut);line-height:1.5}
.epm-k{font-size:.66rem;letter-spacing:.08em;color:var(--mut);margin-bottom:8px;font-weight:600}
.epm-v label{display:block;font-size:.68rem;color:var(--mut);margin:8px 0 4px}
.epm-inp{min-height:30px;padding:6px 9px;border:1px solid #E1E4F2;border-radius:8px;font-size:.76rem;background:#fff;display:flex;align-items:center;color:#111}
.epm-inp:empty::before{content:attr(data-ph);color:#9AA3B2}
.epm-inp.typing::after{content:"";width:1px;height:1em;background:#111;margin-left:1px;animation:epmBlink 1s steps(1) infinite}
.epm-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.epm-row{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;margin-bottom:8px}
.epm-row>div{flex:1 1 90px}
.epm-b2{display:inline-block;font-size:.72rem;padding:7px 12px;border-radius:8px;border:1px solid #E1E4F2;background:#fff;color:#2B2F52;transition:transform .15s,background .3s}
.epm-b2.dark{background:#6B7280;color:#fff;border-color:#6B7280}
.epm-b2.amber{background:#FEF3C7;border-color:#F3D98B;color:#B45309;font-weight:600}
.epm-b2.sent{background:#DCFCE7;border-color:#86D9A5;color:#15803D}
.epm-ind{display:inline-block;font-size:.74rem;font-weight:600;padding:8px 14px;border-radius:8px;background:var(--ind);color:#fff;transition:transform .15s,background .3s}
.epm-ind.sent{background:#15803D}
.epm-bf{border:1px solid #F3D98B;background:#FFFCF0;border-radius:10px;padding:10px;margin-top:10px;font-size:.72rem}
.epm-bf b{display:block;color:#B45309;margin-bottom:6px;font-size:.76rem}
.epm-chk{display:flex;gap:8px;align-items:center;color:#334155}
