    function unmount(k){                          // drop a tour's panel when the visitor moves on; it is rebuilt if they come back
      var slot=$('ept-slot-'+k); if(!slot||!mounted[k]) return;
      slot.innerHTML=''; mounted[k]=false; delete T[k];
    }
    var loading=null;
    function loadTours(){                         // the panels and tour scripts live in a separate file, fetched on demand
      if(window.EPPanels) return Promise.resolve();
      var src=root.getAttribute('data-tours'); if(!src) return Promise.reject();
      if(loading) return loading;
      loading=new Promise(function(res,rej){
        var sc=document.createElement('script'); sc.src=src; sc.async=true; sc.onload=res;
        sc.onerror=function(){loading=null; rej();}; document.head.appendChild(sc);
      });
      return loading;
    }
    function ensure(k){                           // build a tour's panel when it is needed
      if(mounted[k]) return Promise.resolve();
      return loadTours().then(function(){
        if(mounted[k]||(cur&&cur!==k)) return;
        var slot=$('ept-slot-'+k), html=window.EPPanels&&window.EPPanels[k]; if(!slot||!html||!BOOT[k]) return;
        slot.innerHTML=html; mounted[k]=true; BOOT[k]();
      });
    }
    var NM={solve:'timetables',fees:'fees',fin:'reports',kemis:'kemis',hr:'payroll',proc:'procurement'};
    function track(n,p){try{if(typeof gtag==='function') gtag('event',n,Object.assign({page_path:location.pathname},p||{}));}catch(e){}}
    root.addEventListener('click',function(e){
      var a=e.target&&e.target.closest?e.target.closest('a[data-cta],a[data-link]'):null; if(!a) return;
      if(a.hasAttribute('data-cta')) track('tour_cta_click',{cta:a.getAttribute('data-cta'),tour:NM[cur]||''});
      else track('tour_link_click',{link:a.getAttribute('data-link'),tour:NM[cur]||''});
    });
    if(reduce) pb.hidden=true;
    function label(){pb.textContent=paused?'Resume':'Pause'; pb.setAttribute('aria-pressed',paused?'true':'false');}
    function select(k,viaChain,why){
      started=true;                               // any selection means autoplay must not take over later
      clearTimeout(timer);
      if(cur&&T[cur]) T[cur].stop();
      K.forEach(function(x){if(x!==k) unmount(x);});   // also drops a tour that was pre-built before anything was selected
      K.forEach(function(x){if(x!==k) P[x].hidden=true;});
      K.forEach(function(x){var on=x===k; tabs[x].setAttribute('aria-selected',on?'true':'false'); tabs[x].tabIndex=on?0:-1;});
      P[k].hidden=false; cur=k; paused=false; held=false; label(); if(!viaChain) chain=false;
      track('tour_started',{tour:NM[k],trigger:why||(viaChain?'autoplay':'tab')});
      ensure(k).then(function(){ if(cur===k&&T[k]) T[k].start(); },function(){});
    }
    T.onDone=function(k){
      if(!reduce&&k===cur) track('tour_completed',{tour:NM[k]});
      if(reduce||!chain||k!==cur) return;
      var i=CHAIN.indexOf(k);
      if(i>-1&&i<CHAIN.length-1) timer=setTimeout(function(){if(chain) select(CHAIN[i+1],true,'chain');},1500); else chain=false;
    };
    K.forEach(function(k,i){
      tabs[k].addEventListener('click',function(){select(k,false,'tab');});
      tabs[k].addEventListener('keydown',function(e){
        var j=-1; if(e.key==='ArrowRight') j=(i+1)%K.length; else if(e.key==='ArrowLeft') j=(i+K.length-1)%K.length; else if(e.key==='Home') j=0; else if(e.key==='End') j=K.length-1;
        if(j>-1){e.preventDefault(); tabs[K[j]].focus(); select(K[j],false,'tab');}
