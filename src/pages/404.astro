---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page not found | Edupath SMS"
  description="That page could not be found. Head back to the Edupath SMS homepage, see pricing, or try the live demo."
  path="/404"
>
  <Nav active="" />
  <main id="main" class="nf">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1>We couldn&rsquo;t find that page.</h1>
      <p class="nf-lead">The link may be old or mistyped. These will get you back on track.</p>
      <div class="nf-actions">
        <a class="btn btn--primary" href="/">Go to the homepage</a>
        <a class="btn btn--secondary" href="/#pricing">See pricing</a>
        <a class="btn btn--secondary" href="https://app.edupath.co.ke/login?demo=1">Try the live demo</a>
      </div>
      <p class="nf-more">
        Looking for something specific?
        <a href="/#features">Features</a>,
        <a href="/blog">Blog</a>,
        <a href="/#faq">FAQ</a> or
        <a href="https://wa.me/254711606968" rel="noopener">message us on WhatsApp</a>.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf { min-height: 62vh; display: grid; place-items: center; padding: 120px 24px 80px; text-align: center; }
  .nf-inner { max-width: 560px; }
  .nf-code { font-family: var(--font-display); font-size: 5rem; line-height: 1; font-weight: 700; color: var(--color-accent); margin-bottom: 12px; }
  .nf h1 { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.15; margin-bottom: 14px; }
  .nf-lead { color: var(--color-muted, #4b6b67); margin-bottom: 28px; line-height: 1.6; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 28px; }
  .nf-more { font-size: .95rem; color: var(--color-muted, #4b6b67); line-height: 1.7; }
  .nf-more a { color: var(--color-accent); font-weight: 600; }
  @media (max-width: 640px) { .nf-actions .btn { width: 100%; } }
</style>
