---
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const links = [
  { href: '/#features', label: 'Features', match: ['/cbe-school-management', '/mpesa-school-fees', '/parent-portal', '/school-attendance'] },
  { href: '/#portals', label: 'Portals' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];

const isActive = (l) => {
  if (active && l.href === active) return true;
  if (l.match && active && l.match.includes(active)) return true;
  return false;
};
---

<nav class="nav" aria-label="Primary">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
            stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      Edupath SMS
    </a>

    <div class="nav-links">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isActive(l) ? 'page' : undefined}>{l.label}</a>
        ))
      }
    </div>

    <div class="nav-actions">
      <a class="btn btn--secondary" href="https://app.edupath.co.ke/portal" target="_blank">Sign In</a>
      <a class="btn btn--primary" href="/#register">Get Started Free</a>
    </div>

    <button class="nav-burger" id="navBurger" aria-expanded="false" aria-controls="navSheet" aria-label="Toggle navigation">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/>
      </svg>
    </button>
  </div>
</nav>

<div class="nav-sheet" id="navSheet" aria-label="Mobile navigation">
  {
    links.map((l) => (
      <a href={l.href} aria-current={isActive(l) ? 'page' : undefined}>{l.label}</a>
    ))
  }
  <a class="btn btn--secondary" href="https://app.edupath.co.ke/portal" target="_blank">Sign In</a>
  <a class="btn btn--primary" href="/#register">Get Started Free</a>
</div>

<script is:inline>
  {
    const burger = document.getElementById('navBurger');
    const sheet = document.getElementById('navSheet');
    if (burger && sheet) {
      const setOpen = (open) => {
        sheet.classList.toggle('is-open', open);
        burger.setAttribute('aria-expanded', String(open));
      };
      burger.addEventListener('click', () => setOpen(!sheet.classList.contains('is-open')));
      sheet.addEventListener('click', (e) => {
        if (e.target.closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
    }
  }
</script>